# Private key for deployment (remove 0x prefix)
PRIVATE_KEY=your_private_key_here

# Base RPC URL (optional - using default from foundry.toml)
BASE_RPC_URL=https://mainnet.base.org

# Base Sepolia RPC URL for testing (optional)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# BaseScan API key for contract verification (get from https://basescan.org/apis)
BASESCAN_API_KEY=your_basescan_api_key_here

# Legacy keys for compatibility
RPC_URL=your_rpc_url_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here